# Copy to .env.local (which is gitignored) and fill in. 
# Vite does NOT read this file — it only loads .env, .env.local and .env.[mode] variants, so real values placed here have no effect and the app stays in mock mode.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Base URL of the n8n webhook API, with no trailing slash, e.g.
#   https://your-instance.app.n8n.cloud/webhook
# Leave this EMPTY to run against the in-memory mock: no n8n instance and no Google client needed, and the header offers a "Sign in (demo)" button.
VITE_API_BASE=

# Google OAuth client ID. Public by design — it ships in the built bundle and is not a secret. The client SECRET must never appear here; it belongs only in an n8n credential, because n8n is the confidential client.
VITE_GOOGLE_CLIENT_ID=

# The n8n callback webhook that exchanges the authorization code for tokens. Must be an ABSOLUTE https URL, not a path: Google rejects relative redirect URIs, and this must match an Authorized redirect URI on the OAuth client character for character. Note n8n's test and production webhooks have different paths (/webhook-test/... vs /webhook/...), so register whichever you point at here.
VITE_OAUTH_REDIRECT=
