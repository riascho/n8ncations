    {
      "name": "Tidy profile update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const request = $input.first().json;\nconst body = request.body ?? {};\n// Same cap and whitespace rules as the profile form.\nconst tidy = (value) => {\n  if (typeof value !== \"string\") return null;\n  const text = value.replace(/\\s+/g, \" \").trim().slice(0, 60);\n  return text === \"\" ? null : text;\n};\nreturn [\n  {\n    json: {\n      sub: request.jwtPayload.sub,\n      team: tidy(body.team),\n      jobTitle: tidy(body.jobTitle),\n    },\n  },\n];"
      },
