    {
      "name": "Build /mE",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const claims = $(\"Webhook /me\").first().json.jwtPayload;\nconst sub = claims.sub;\n// A colleague without a profile row still gets an answer, built from\n// the token, instead of no response at all.\nconst profile = $(\"Get profile\").all().map((i) => i.json).find((r) => r.user_sub === sub) ?? {};\nconst mine = $(\"Get my signups\").all().map((i) => i.json).filter((r) => r.workation_id);\nconst waiting = $(\"Get waitlist rows\").all().map((i) => i.json).filter((r) => r.workation_id);\nconst trips = $(\"Get workations\").all().map((i) => i.json).filter((r) => r.workation_id);\nconst voteRows = $(\"Get my votes\").all().map((i) => i.json).filter((r) => r.poll_id);\n\nconst toList = (value) => {\n  if (Array.isArray(value)) return value;\n  if (typeof value !== \"string\" || value.trim() === \"\") return [];\n  try {\n    const parsed = JSON.parse(value);\n    return Array.isArray(parsed) ? parsed : [];\n  } catch {\n    return [];\n  }\n};\n\n// Generic over poll_id. Newest row per poll, in case a race left two.\nconst latest = new Map();\nfor (const row of voteRows) {\n  const seen = latest.get(row.poll_id);\n  if (!seen || new Date(row.updatedAt) > new Date(seen.updatedAt)) {\n    latest.set(row.poll_id, row);\n  }\n}\nconst votes = {};\nfor (const [pollId, row] of latest) {\n  const selected = toList(row.options);\n  if (selected.length > 0) votes[pollId] = selected;\n}\n\nconst position = (row) =>\n  1 +\n  waiting.filter(\n    (w) =>\n      w.workation_id === row.workation_id &&\n      new Date(w.createdAt) < new Date(row.createdAt),\n  ).length;\n\nreturn [\n  {\n    json: {\n      sub,\n      name: profile.name || claims.name || \"\",\n      email: profile.email || claims.email || \"\",\n      picture: profile.picture || claims.picture || \"\",\n      team: profile.team || null,\n      jobTitle: profile.jobTitle || null,\n      votes,\n      signups: mine.filter((r) => r.status === \"going\").map((r) => r.workation_id),\n      waitlist: mine\n        .filter((r) => r.status === \"waitlist\")\n        .map((r) => ({ workationId: r.workation_id, position: position(r) })),\n      organizing: trips.filter((t) => t.organizer === sub).map((t) => t.workation_id),\n    },\n  },\n];"
      },
