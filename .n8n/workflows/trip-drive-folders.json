    {
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Compared as text: every date is a YYYY-MM-DD String column.\nconst today = $today.toFormat(\"yyyy-MM-dd\");\nconst isDay = (s) => /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(s);\nconst trips = $(\"Get workations\").all().map((i) => i.json).filter((r) => r.workation_id);\nconst going = $(\"Get going signups\").all().map((i) => i.json)\n  .filter((r) => r.workation_id && r.user_sub && r.status === \"going\");\nconst emailBySub = new Map();\nfor (const p of $(\"Get profiles\").all().map((i) => i.json)) {\n  if (p.user_sub && p.email) emailBySub.set(p.user_sub, String(p.email).trim().toLowerCase());\n}\n\n// One item per trip with work to do today:\n// - create: the trip is on and has no folder yet (then it is synced like \"sync\")\n// - sync: the trip is on; share the folder with anyone going who lacks access\n// - domain: the trip has ended; let everyone at n8n.io view the folder, once\nconst out = [];\nfor (const t of trips) {\n  const start = String(t.start_date ?? \"\");\n  const end = String(t.end_date ?? \"\");\n  if (!isDay(start) || !isDay(end)) continue;\n  const folderId = t.drive_folder_id ? String(t.drive_folder_id) : \"\";\n  if (start <= today && today <= end) {\n    // Everyone going, plus the organizer. People without a profile email are skipped.\n    const subs = new Set(going.filter((r) => r.workation_id === t.workation_id).map((r) => r.user_sub));\n    if (t.organizer) subs.add(t.organizer);\n    const emails = [...new Set([...subs].map((s) => emailBySub.get(s)).filter(Boolean))];\n    const title = t.title || \"n8ncation #\" + t.workation_id;\n    out.push({ json: {\n      action: folderId ? \"sync\" : \"create\",\n      workation_id: t.workation_id,\n      folder_id: folderId,\n      folder_name: title + \": \" + t.place + \" (\" + start + \" to \" + end + \")\",\n      emails,\n    } });\n  } else if (end < today && folderId && t.drive_domain_shared !== true) {\n    out.push({ json: { action: \"domain\", workation_id: t.workation_id, folder_id: folderId, folder_name: \"\", emails: [] } });\n  }\n}\nreturn out;"
      },
      "id": "e81fcc26-f230-4cfa-aa0a-da81d7dea66c",
      "position": [960, 0]
    },
