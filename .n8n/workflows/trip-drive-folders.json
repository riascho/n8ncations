    {
      "name": "Missing shares",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One item per (trip, email) that should have access and doesn't yet.\n// Nobody is ever removed: people who drop out keep what they uploaded.\nconst out = [];\n$input.all().forEach((item, index) => {\n  const trip = $(\"Trip to sync\").itemMatching(index).json;\n  const have = new Set(\n    (item.json.permissions ?? [])\n      .filter((p) => p.emailAddress)\n      .map((p) => String(p.emailAddress).toLowerCase()),\n  );\n  for (const email of trip.emails ?? []) {\n    if (!have.has(email)) out.push({ json: { workation_id: trip.workation_id, folder_id: trip.folder_id, email } });\n  }\n});\nreturn out;"
      },
