    {
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const request = $(\"POST /rsvp\").first().json;\nconst sub = request.jwtPayload.sub;\nconst { workationId, attending } = request.body ?? {};\nconst fail = (statusCode, message) => [\n  { json: { action: \"answer\", statusCode, body: { message } } },\n];\n\nif (typeof workationId !== \"string\" || typeof attending !== \"boolean\") {\n  return fail(400, \"Send a workationId and attending: true or false.\");\n}\nconst trip = $(\"Get trip\").all().map((i) => i.json).find((r) => r.workation_id === workationId);\nif (!trip) return fail(404, \"We could not find that n8ncation.\");\n// String column, YYYY-MM-DD, so it compares correctly as text. RSVPs\n// stay open through the last day, like the frontend's isPast().\nif (String(trip.end_date) < $today.toFormat(\"yyyy-MM-dd\")) {\n  return fail(400, \"This n8ncation has already happened.\");\n}\n\nconst rows = $(\"Get trip signups\")\n  .all()\n  .map((i) => i.json)\n  .filter((r) => r.workation_id === workationId)\n  .sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt));\nconst mine = rows.find((r) => r.user_sub === sub);\nconst waiting = rows.filter((r) => r.status === \"waitlist\");\nconst going = rows.filter((r) => r.status === \"going\").length;\nconst positionOf = (who) => {\n  const index = waiting.findIndex((r) => r.user_sub === who);\n  return index < 0 ? null : index + 1;\n};\n\nif (attending) {\n  if (mine) {\n    return [\n      {\n        json: {\n          action: \"answer\",\n          statusCode: 200,\n          body: { status: mine.status, position: positionOf(sub) },\n        },\n      },\n    ];\n  }\n  const full = typeof trip.capacity === \"number\" && going >= trip.capacity;\n  const status = full ? \"waitlist\" : \"going\";\n  return [\n    {\n      json: {\n        action: \"insert\",\n        statusCode: 200,\n        body: { status, position: full ? waiting.length + 1 : null },\n        row: { workation_id: workationId, user_sub: sub, status },\n      },\n    },\n  ];\n}\n\nif (!mine) return [{ json: { action: \"nothing\" } }];\n// Giving up a spot hands it to whoever has waited longest.\nconst next = mine.status === \"going\" ? waiting[0] : undefined;\nreturn [\n  {\n    json: {\n      action: \"delete\",\n      row: { workation_id: workationId, user_sub: sub },\n      promoteSub: next ? next.user_sub : \"\",\n    },\n  },\n];"
      },
