    {
      "name": "Validate update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const request = $(\"POST /pitch-update\").first().json;\nconst sub = request.jwtPayload.sub;\nconst body = request.body ?? {};\nconst fail = (statusCode, message) => [{ json: { ok: false, statusCode, body: { message } } }];\n\nif (typeof body.pitchId !== \"string\") return fail(400, \"Send the pitchId of the pitch to change.\");\n// Only the organizer may change a pitch. A missing pitch and someone else's\n// get the same 404, so the answer doesn't reveal which. 404, not 403: the\n// frontend reads every 403 as an expired session.\nconst pitch = $(\"Get pitch\").all().map((i) => i.json).find((r) => r.pitch_id === body.pitchId);\nif (!pitch || pitch.organizer !== sub) return fail(404, \"We could not find that pitch.\");\n// An expired pitch can be edited too: saving it, with a deadline from today\n// (checked below), reopens it. Cancelled and confirmed ones are closed.\nif (pitch.status !== \"open\" && pitch.status !== \"expired\") return fail(400, \"This pitch is closed.\");\n\n// Same rules as POST /pitch and PITCH_LIMITS in src/features/pitches.ts.\nconst today = $today.toFormat(\"yyyy-MM-dd\");\nconst isDay = (value) => typeof value === \"string\" && /^\\d{4}-\\d{2}-\\d{2}$/.test(value);\nconst line = (value, max) =>\n  typeof value === \"string\" ? value.replace(/\\s+/g, \" \").trim().slice(0, max) : \"\";\nconst whole = (value) => (Number.isInteger(value) ? value : NaN);\n\nconst place = line(body.place, 60);\nconst description =\n  typeof body.description === \"string\"\n    ? body.description.replace(/[^\\S\\n]+/g, \" \").replace(/\\n{3,}/g, \"\\n\\n\").trim().slice(0, 600)\n    : \"\";\n// Optional: null means no limit, like a trip's capacity.\nconst capacity = body.capacity === null || body.capacity === undefined ? null : whole(body.capacity);\nconst threshold = whole(body.threshold);\nconst cost = body.costEstimate === null || body.costEstimate === undefined ? null : whole(body.costEstimate);\nconst url = line(body.accommodationUrl ?? \"\", 500);\nconst costIncludes = line(body.costIncludes ?? \"\", 200);\n// Not trimmed to length like the text fields: a cut-off link is a broken one.\nconst imageUrl = typeof body.imageUrl === \"string\" ? body.imageUrl.trim() : \"\";\nconst imageAlt = line(body.imageAlt ?? \"\", 150);\n\nif (!place) return fail(400, \"Add a place.\");\nif (!description) return fail(400, \"Describe the plan.\");\nif (!isDay(body.startDate) || body.startDate <= today) return fail(400, \"Pick a start date in the future.\");\nif (!isDay(body.endDate) || body.endDate < body.startDate) return fail(400, \"The trip ends before it starts.\");\nif (capacity !== null && !(capacity >= 2 && capacity <= 100)) {\n  return fail(400, \"Group size must be between 2 and 100, or empty for no limit.\");\n}\n// Always required: it decides whether the trip goes ahead.\nif (!(threshold >= 2 && threshold <= (capacity ?? 100))) {\n  return fail(\n    400,\n    capacity === null\n      ? \"Interest needed must be between 2 and 100.\"\n      : \"Interest needed must be between 2 and the group size.\",\n  );\n}\nif (!isDay(body.deadline) || body.deadline < today || body.deadline >= body.startDate) {\n  return fail(400, \"The deadline must be between today and the start date.\");\n}\nif (cost !== null && !(cost >= 0 && cost <= 10000)) {\n  return fail(400, \"Use a whole number of euros up to 10000.\");\n}\n// Rendered as an href, so only http(s) links are stored.\nif (url && !/^https?:\\/\\/[^\\s]+$/i.test(url)) return fail(400, \"Use a full link starting with https://.\");\n\n// A link to a photo hosted elsewhere; nothing is uploaded. https only: the\n// site is served over https, so an http image would be blocked anyway.\nif (imageUrl && (imageUrl.length > 1000 || !/^https:\\/\\/[^\\s]+$/i.test(imageUrl))) {\n  return fail(400, \"Use a photo link starting with https://.\");\n}\nif (imageUrl && !imageAlt) return fail(400, \"Describe the photo for people using a screen reader.\");\n\n// Every field is replaced and the status set to open. Interest and organizer\n// stay as they are.\nreturn [\n  {\n    json: {\n      ok: true,\n      pitch_id: body.pitchId,\n      organizer: sub,\n      // The status read above: \"Update pitch\" only writes while it's unchanged.\n      status: pitch.status,\n      // The pitch as it was, so \"Slack Bot Notifier\" can say in the thread what changed.\n      before: JSON.stringify({\n        status: pitch.status,\n        place: pitch.place,\n        start_date: pitch.start_date,\n        end_date: pitch.end_date,\n        description: pitch.description,\n        accommodation_url: pitch.accommodation_url,\n        image_url: pitch.image_url,\n        capacity: pitch.capacity,\n        threshold: pitch.threshold,\n        deadline: pitch.deadline,\n        cost_estimate: pitch.cost_estimate,\n        cost_includes: pitch.cost_includes,\n      }),\n      row: {\n        place,\n        start_date: body.startDate,\n        end_date: body.endDate,\n        description,\n        accommodation_url: url,\n        image_url: imageUrl,\n        // A description without a photo describes nothing.\n        image_alt: imageUrl ? imageAlt : \"\",\n        capacity,\n        threshold,\n        deadline: body.deadline,\n        cost_estimate: cost,\n        cost_includes: costIncludes,\n      },\n    },\n  },\n];"
      },
