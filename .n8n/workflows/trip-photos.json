    {
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// 404 unless the trip's folder is open to everyone at n8n.io: that is\n// when GET /workations sends its photosUrl, the only time the site asks.\n// 404 rather than 403: the frontend reads every 403 as an expired session.\nconst query = $(\"GET /trip-photos\").first().json.query ?? {};\nconst workationId = typeof query.workationId === \"string\" ? query.workationId.trim() : \"\";\nconst trip = $input.all().map((i) => i.json).find((r) => r.workation_id && r.workation_id === workationId);\nif (!workationId || !trip || trip.drive_domain_shared !== true || !trip.drive_folder_id) {\n  return [{ json: { ok: false, statusCode: 404, body: { message: \"No photos for this n8ncation.\" } } }];\n}\nreturn [{ json: { ok: true, statusCode: 200, body: {}, folderId: String(trip.drive_folder_id) } }];"
      },
      "id": "27a44055-9bc6-4afc-93b5-ecfb93f736fe",
      "position": [480, 0]
    },
    {
      "name": "OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      },
      "id": "44d13703-53f9-4548-8bcf-30df5783a3dc",
      "position": [720, 0]
    },
    {
      "name": "List photos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "='{{ $json.folderId }}' in parents and trashed = false and mimeType contains 'image/'"
            },
            { "name": "orderBy", "value": "createdTime" },
            { "name": "pageSize", "value": "8" },
            { "name": "fields", "value": "files(id,mimeType,thumbnailLink)" }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": { "id": "N1Aja1pCQRbh27iB", "name": "Google Drive" }
      },
