      "position": [1440, -192]
    },
    {
      "name": "Fetch thumbnail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "={{ String($json.thumbnailLink ?? \"\").replace(/=s\\d+$/, \"=w1600\") }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {
          "response": {
            "response": { "responseFormat": "file", "outputPropertyName": "data" }
          }
        }
      },
      "credentials": {
        "googleDriveOAuth2Api": { "id": "N1Aja1pCQRbh27iB", "name": "Google Drive" }
      },
      "id": "f8dcb550-8725-41c9-9666-4246d7ea5d73",
      "position": [1680, -192]
    },
    {
      "name": "Build photos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Each thumbnail inline as a data: URL: the folder is private to n8n.io,\n// so the browser couldn't load it from Drive itself. A thumbnail that\n// failed to download (Fetch thumbnail continues on error) is skipped.\nconst items = $input.all();\nconst photos = [];\nfor (let i = 0; i < items.length; i++) {\n  const file = items[i].binary?.data;\n  if (!file) continue;\n  const mime = String(file.mimeType ?? \"\");\n  if (!mime.startsWith(\"image/\")) continue;\n  const buffer = await this.helpers.getBinaryDataBuffer(i, \"data\");\n  photos.push({ src: \"data:\" + mime + \";base64,\" + buffer.toString(\"base64\") });\n}\nreturn [{ json: { statusCode: 200, body: { photos } } }];"
      },
      "id": "6378f01d-9d4e-42d0-a471-eefd142116a5",
      "position": [1920, -192]
    },
    {
      "name": "No photos yet",
