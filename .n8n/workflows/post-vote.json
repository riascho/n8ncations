    {
      "name": "Validate vote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Identity from the token, never from the body.\nconst request = $(\"POST /vote\").first().json;\nconst { pollId, options } = request.body ?? {};\nif (typeof pollId !== \"string\" || !Array.isArray(options)) {\n  return [{ json: { ok: false, statusCode: 400, body: { message: \"Send a pollId and an options array.\" } } }];\n}\nconst allowed = new Set(\n  $(\"Get poll options\").all().map((i) => i.json).filter((r) => r.poll_id === pollId).map((r) => r.value),\n);\nif (allowed.size === 0) {\n  return [{ json: { ok: false, statusCode: 404, body: { message: \"We could not find that poll.\" } } }];\n}\nconst validated = [...new Set(options)].filter((v) => typeof v === \"string\" && allowed.has(v));\nreturn [\n  {\n    json: {\n      ok: true,\n      poll_id: pollId,\n      user_sub: request.jwtPayload.sub,\n      options: JSON.stringify(validated),\n    },\n  },\n];"
      },
      "id": "1fe8dd3e-75d0-4e1d-aed0-c89795b10149",
