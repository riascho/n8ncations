    {
      "name": "Validate cancel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const request = $(\"POST /pitch-cancel\").first().json;\nconst sub = request.jwtPayload.sub;\nconst body = request.body ?? {};\nconst fail = (statusCode, message) => [{ json: { ok: false, statusCode, body: { message } } }];\n\nif (typeof body.pitchId !== \"string\") return fail(400, \"Send the pitchId of the pitch to cancel.\");\n// Only the organizer may change a pitch. A missing pitch and someone else's\n// get the same 404, so the answer doesn't reveal which. 404, not 403: the\n// frontend reads every 403 as an expired session.\nconst pitch = $(\"Get pitch\").all().map((i) => i.json).find((r) => r.pitch_id === body.pitchId);\nif (!pitch || pitch.organizer !== sub) return fail(404, \"We could not find that pitch.\");\nif (pitch.status !== \"open\") return fail(400, \"This pitch is closed.\");\n\n// Same cap as PITCH_LIMITS.cancelReason in src/features/pitches.ts. Line\n// breaks are kept, like the description.\nconst reason =\n  typeof body.reason === \"string\"\n    ? body.reason.replace(/[^\\S\\n]+/g, \" \").replace(/\\n{3,}/g, \"\\n\\n\").trim().slice(0, 300)\n    : \"\";\nif (!reason) return fail(400, \"Say why you’re cancelling the pitch.\");\n\n// Interest rows are kept. \"Pitch decisions\" only reads open pitches, so a\n// cancelled one is never confirmed or expired.\nreturn [\n  {\n    json: {\n      ok: true,\n      pitch_id: body.pitchId,\n      organizer: sub,\n      row: { status: \"cancelled\", cancel_reason: reason },\n    },\n  },\n];"
      },
