      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const idToken = $input.first().json.id_token ?? \"\";\nlet claims = {};\ntry {\n  claims = JSON.parse(Buffer.from(idToken.split(\".\")[1] ?? \"\", \"base64url\").toString(\"utf8\"));\n} catch {\n  claims = {};\n}\n// The token comes straight from Google's token endpoint over TLS, so\n// its signature is not re-checked. The Workspace domain is: an\n// Internal OAuth app already limits sign-in to n8n accounts, and this\n// keeps that true if the app is ever switched to External.\nconst allowed =\n  typeof claims.sub === \"string\" && claims.hd === \"n8n.io\" && claims.email_verified === true;\nreturn [{ json: { allowed, claims } }];"
      },
      "id": "123ddbc4-e123-46ae-94fb-adee24882825",
