    {
      "name": "Validate interest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const request = $(\"POST /pitch-interest\").first().json;\nconst { pitchId, interested } = request.body ?? {};\nconst fail = (statusCode, message) => [\n  { json: { ok: false, statusCode, body: { message } } },\n];\nif (typeof pitchId !== \"string\" || typeof interested !== \"boolean\") {\n  return fail(400, \"Send a pitchId and interested: true or false.\");\n}\nconst pitch = $(\"Get pitch\").all().map((i) => i.json).find((r) => r.pitch_id === pitchId);\nif (!pitch) return fail(404, \"We could not find that pitch.\");\nif (pitch.status !== \"open\") return fail(400, \"This pitch is closed.\");\nif (String(pitch.deadline) < $today.toFormat(\"yyyy-MM-dd\")) {\n  return fail(400, \"The deadline for this pitch has passed.\");\n}\n// The upsert can't tell a new row from a repeat, so compare with what was\n// stored before. Only a real change notifies the organizer.\nconst sub = request.jwtPayload.sub;\nconst wasInterested = $(\"Get pitch interest\")\n  .all()\n  .some((i) => i.json.pitch_id === pitchId && i.json.user_sub === sub);\nreturn [\n  {\n    json: {\n      ok: true,\n      interested,\n      pitch_id: pitchId,\n      user_sub: sub,\n      changed: interested !== wasInterested,\n    },\n  },\n];"
      },
      "id": "cede9f59-69e3-48e7-a005-1ac7df6dd1e0",
