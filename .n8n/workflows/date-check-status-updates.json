    {
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Compared as text: every date is a YYYY-MM-DD String column.\nconst today = $today.toFormat(\"yyyy-MM-dd\");\nconst pitches = $(\"Get open pitches\").all().map((i) => i.json).filter((r) => r.pitch_id && r.status === \"open\");\nconst interest = $(\"Get interest\").all().map((i) => i.json).filter((r) => r.pitch_id);\nconst trips = $(\"Get workations\").all().map((i) => i.json).filter((r) => r.workation_id);\n\nlet nextId =\n  Math.max(0, ...trips.map((t) => Number(t.workation_id)).filter(Number.isFinite)) + 1;\nconst slugs = new Set(trips.map((t) => t.slug));\nconst slugFor = (place, startDate) => {\n  const base = `${String(place)\n    .toLowerCase()\n    .normalize(\"NFKD\")\n    .replace(/[̀-ͯ]/g, \"\")\n    .replace(/[^a-z]+/g, \"-\")\n    .replace(/^-|-$/g, \"\")}-${String(startDate).slice(0, 4)}`;\n  let slug = base;\n  for (let n = 2; slugs.has(slug); n += 1) slug = `${base}-${n}`;\n  slugs.add(slug);\n  return slug;\n};\n\nconst createTrips = [];\nconst createSignups = [];\nconst updates = [];\n// One per decided pitch, sent to \"Slack Bot Notifier\" once every write is done.\nconst notifications = [];\nfor (const pitch of pitches) {\n  // Oldest interest first; one row per person.\n  const seen = new Set();\n  const people = interest\n    .filter((r) => r.pitch_id === pitch.pitch_id)\n    .sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt))\n    .filter((r) => !seen.has(r.user_sub) && seen.add(r.user_sub));\n\n  if (people.length >= pitch.threshold) {\n    const workationId = String(nextId++).padStart(2, \"0\");\n    createTrips.push({\n      workation_id: workationId,\n      slug: slugFor(pitch.place, pitch.start_date),\n      title: `n8ncation #${workationId}`,\n      place: pitch.place,\n      start_date: pitch.start_date,\n      end_date: pitch.end_date,\n      description: pitch.description ?? \"\",\n      // Carried over so the trip keeps what the pitch showed: its photo\n      // link, accommodation link and cost estimate.\n      image_url: pitch.image_url ?? \"\",\n      image_alt: pitch.image_alt ?? \"\",\n      accommodation_url: pitch.accommodation_url ?? \"\",\n      cost_estimate: typeof pitch.cost_estimate === \"number\" ? pitch.cost_estimate : null,\n      cost_includes: pitch.cost_includes ?? \"\",\n      organizer: pitch.organizer,\n      capacity: pitch.capacity,\n    });\n    people.forEach((row, index) =>\n      createSignups.push({\n        workation_id: workationId,\n        user_sub: row.user_sub,\n        // No capacity means no limit: everyone interested gets a spot.\n        status: typeof pitch.capacity !== \"number\" || index < pitch.capacity ? \"going\" : \"waitlist\",\n      }),\n    );\n    updates.push({ pitch_id: pitch.pitch_id, status: \"confirmed\", workation_id: workationId });\n    notifications.push({ event: \"pitch_confirmed\", pitchId: pitch.pitch_id, workationId });\n  } else if (String(pitch.deadline) < today) {\n    updates.push({ pitch_id: pitch.pitch_id, status: \"expired\", workation_id: \"\" });\n    notifications.push({ event: \"pitch_expired\", pitchId: pitch.pitch_id, workationId: \"\" });\n  }\n}\nreturn [{ json: { createTrips, createSignups, updates, notifications } }];"
      },
      "id": "bea48167-faa6-4c8e-ac68-63ee0c04ac14",
      "position": [
