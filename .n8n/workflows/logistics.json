    {
      "name": "Format logistics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const sub = $(\"Webhook /logistics\").first().json.jwtPayload.sub;\nconst row = $input.all().map((i) => i.json).find((r) => r.user_sub === sub);\nconst pick = (value) => (typeof value === \"string\" && value !== \"\" ? value : null);\nreturn [\n  {\n    json: {\n      mine: row\n        ? {\n            dietary: pick(row.dietary),\n            roomPreference: pick(row.room_preference),\n            emergencyContact: pick(row.emergency_contact),\n            expectations: pick(row.expectations),\n          }\n        : null,\n    },\n  },\n];"
      },
