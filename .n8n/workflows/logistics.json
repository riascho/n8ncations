    {
      "name": "Validate logistics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const request = $(\"Webhook /logistics\").first().json;\nconst sub = request.jwtPayload.sub;\nconst body = request.body ?? {};\nconst fail = (statusCode, message) => [\n  { json: { ok: false, statusCode, body: { message } } },\n];\n\nif (typeof body.workationId !== \"string\") return fail(400, \"Send a workationId.\");\nconst trip = $(\"Get trip\").all().map((i) => i.json).find((r) => r.workation_id === body.workationId);\nif (!trip) return fail(404, \"We could not find that n8ncation.\");\nif (String(trip.end_date) < $today.toFormat(\"yyyy-MM-dd\")) {\n  return fail(400, \"This n8ncation has already happened.\");\n}\nconst signedUp = $(\"Get my signup\").all().some((i) => i.json.user_sub === sub);\nif (!signedUp) return fail(400, \"Sign up for this n8ncation first.\");\n\n// Same rules as the form: whitespace collapsed, 200 characters,\n// empty stored as null.\nconst text = (value) => {\n  if (typeof value !== \"string\") return null;\n  const cleaned = value.replace(/\\s+/g, \" \").trim().slice(0, 200);\n  return cleaned === \"\" ? null : cleaned;\n};\n// expectations is multi-line, like a pitch description: line breaks kept\n// (at most one blank line), other whitespace collapsed, 500 characters.\nconst paragraph = (value) => {\n  if (typeof value !== \"string\") return null;\n  const cleaned = value\n    .replace(/[^\\S\\n]+/g, \" \")\n    .replace(/\\n{3,}/g, \"\\n\\n\")\n    .trim()\n    .slice(0, 500);\n  return cleaned === \"\" ? null : cleaned;\n};\nconst row = {\n  workation_id: body.workationId,\n  user_sub: sub,\n  dietary: text(body.dietary),\n  room_preference: text(body.roomPreference),\n  emergency_contact: text(body.emergencyContact),\n  expectations: paragraph(body.expectations),\n};\nreturn [{ json: { ok: true, row } }];"
      },
