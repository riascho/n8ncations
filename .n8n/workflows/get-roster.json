    {
      "name": "Build roster",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const request = $(\"GET /roster\").first().json;\nconst sub = request.jwtPayload.sub;\nconst workationId = request.query?.workationId;\nconst trip = $(\"Get trip\").all().map((i) => i.json).find((r) => r.workation_id === workationId);\n\n// 404, not 403: the frontend reads every 403 as an expired session.\n// The same answer for \"no such trip\" and \"not yours\" reveals nothing.\nif (!trip || trip.organizer !== sub) {\n  return [\n    { json: { statusCode: 404, body: { message: \"We could not find that n8ncation.\" } } },\n  ];\n}\n\nconst rows = $(\"Get trip signups\")\n  .all()\n  .map((i) => i.json)\n  .filter((r) => r.workation_id === workationId)\n  .sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt));\nconst profiles = new Map(\n  $(\"Get profiles\").all().map((i) => i.json).filter((p) => p.user_sub).map((p) => [p.user_sub, p]),\n);\nconst logistics = new Map(\n  $(\"Get trip logistics\").all().map((i) => i.json).filter((l) => l.user_sub).map((l) => [l.user_sub, l]),\n);\nconst pick = (value) => (typeof value === \"string\" && value !== \"\" ? value : null);\n\nconst going = rows.filter((r) => r.status === \"going\");\nconst waiting = rows.filter((r) => r.status === \"waitlist\");\nconst entry = (row, position) => {\n  const person = profiles.get(row.user_sub) ?? {};\n  const l = logistics.get(row.user_sub);\n  return {\n    name: person.name ?? \"\",\n    email: person.email ?? \"\",\n    team: person.team || null,\n    status: row.status,\n    position,\n    logistics: l\n      ? {\n          dietary: pick(l.dietary),\n          roomPreference: pick(l.room_preference),\n          emergencyContact: pick(l.emergency_contact),\n          expectations: pick(l.expectations),\n        }\n      : null,\n  };\n};\n\nreturn [\n  {\n    json: {\n      statusCode: 200,\n      body: {\n        people: [\n          ...going.map((row) => entry(row, null)),\n          ...waiting.map((row, index) => entry(row, index + 1)),\n        ],\n      },\n    },\n  },\n];"
      },
      "id": "f05c414e-60ed-4201-8a34-5028284f07a1",
