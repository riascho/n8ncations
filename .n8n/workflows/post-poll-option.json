        "jsCode": "const request = $(\"POST /poll-option\").first().json;\nconst { pollId, value } = request.body ?? {};\nconst fail = (message) => [{ json: { ok: false, statusCode: 400, body: { message } } }];\nif (typeof pollId !== \"string\" || typeof value !== \"string\") return fail(\"Send a pollId and a value.\");\nconst cleaned = value.replace(/\\s+/g, \" \").trim().slice(0, 40);\nif (!cleaned) return fail(\"Type an option first.\");\nreturn [\n  {\n    json: {\n      ok: true,\n      poll_id: pollId,\n      value: cleaned,\n      value_key: cleaned.toLowerCase(),\n      created_by_sub: request.jwtPayload.sub,\n    },\n  },\n];"
